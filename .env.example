# Copy to .env and adjust. Every value has a sane default in playwright.config.ts,
# so the suite runs with zero configuration against a local `npm run dev` of Flakeboard.

# Where the React app is served
BASE_URL=http://localhost:5173

# Where the Express API is served
API_BASE_URL=http://localhost:3001

# Credentials used by the auth setup project (see CONTRACT.md)
E2E_EMAIL=paras@flakeboard.dev
E2E_PASSWORD=demo1234

# Set to skip the managed webServer (e.g. when you already have the app running,
# or when you only want to run `--list`)
# PW_SKIP_WEBSERVER=1

# Shard selection can also come from the config rather than the CLI
# SHARD_INDEX=1
# SHARD_TOTAL=4
